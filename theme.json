{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1296px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                { "slug": "brand", "name": "Brand", "color": "#1f2937" },
                { "slug": "brand-dark", "name": "Brand dark", "color": "#111827" },
                { "slug": "accent", "name": "Accent", "color": "#1f2937" },
                { "slug": "accent-dark", "name": "Accent dark", "color": "#111827" },
                { "slug": "button", "name": "Button", "color": "#111827" },
                { "slug": "button-ink", "name": "Button ink", "color": "#ffffff" },
                { "slug": "button-hover", "name": "Button hover", "color": "#374151" },
                { "slug": "ink", "name": "Ink", "color": "#111827" },
                { "slug": "muted", "name": "Muted", "color": "#4b5563" },
                { "slug": "cream", "name": "Cream", "color": "#ffffff" },
                { "slug": "surface", "name": "Surface", "color": "#ffffff" },
                { "slug": "soft", "name": "Soft", "color": "#f3f4f6" },
                { "slug": "night", "name": "Night", "color": "#111827" }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Heading",
                    "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
                },
                {
                    "slug": "body",
                    "name": "Body",
                    "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
                }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "units": [ "px", "em", "rem", "%", "vw", "vh" ],
            "spacingSizes": [
                { "slug": "20", "name": "Space 1", "size": "4px" },
                { "slug": "30", "name": "Space 2", "size": "8px" },
                { "slug": "40", "name": "Space 3", "size": "16px" },
                { "slug": "50", "name": "Space 4", "size": "24px" },
                { "slug": "60", "name": "Space 5", "size": "48px" },
                { "slug": "70", "name": "Space 6", "size": "72px" },
                { "slug": "80", "name": "Space 7", "size": "112px" }
            ]
        },
        "custom": {
            "radius": {
                "sm": "8px",
                "md": "12px",
                "lg": "16px",
                "xl": "24px",
                "pill": "999px"
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--cream)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "1rem",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--50)",
            "padding": {
                "top": "0",
                "right": "var(--wp--preset--spacing--50)",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--50)"
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "600",
                    "lineHeight": "1.15"
                }
            },
            "h1": { "typography": { "fontSize": "clamp(2.25rem, 4.3vw, 3.875rem)" } },
            "h2": { "typography": { "fontSize": "clamp(1.75rem, 3vw, 2.75rem)" } },
            "h3": { "typography": { "fontSize": "1.5rem" } },
            "link": {
                "color": { "text": "var(--wp--preset--color--brand-dark)" }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--button)",
                    "text": "var(--wp--preset--color--button-ink)"
                },
                "border": { "radius": "var(--wp--custom--radius--pill)" },
                ":hover": {
                    "color": { "background": "var(--wp--preset--color--button-hover)" }
                }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "customTemplates": [
        { "name": "wpbun-canvas", "title": "Full width, no title", "postTypes": [ "page" ] }
    ]
}
